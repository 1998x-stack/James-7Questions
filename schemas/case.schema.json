{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/1998x-stack/James-7Questions/blob/main/schemas/case.schema.json",
  "title": "Decision Atlas Case Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "company", "title", "subtitle", "period", "industry", "tags", "status", "abstract", "thesis", "decision", "caveat", "kpis", "timeline", "sources", "frameworks"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "company": {"type": "string", "minLength": 2},
    "title": {"type": "string", "minLength": 5},
    "subtitle": {"type": "string"},
    "period": {"type": "string"},
    "industry": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string"},
    "abstract": {"type": "string", "minLength": 20},
    "thesis": {"type": "string"},
    "decision": {"type": "string"},
    "caveat": {"type": "string", "minLength": 20},
    "kpis": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["label", "value", "note", "source"], "additionalProperties": false, "properties": {"label": {"type":"string"}, "value": {"type":"string"}, "note": {"type":"string"}, "source": {"type":"string"}}}},
    "timeline": {"type": "array", "items": {"type": "object", "required": ["date", "title", "text", "source"], "additionalProperties": false, "properties": {"date": {"type":"string"}, "title": {"type":"string"}, "text": {"type":"string"}, "source": {"type":"string"}}}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "url", "type", "year", "note"], "additionalProperties": false, "properties": {"id": {"type":"string", "pattern":"^S[0-9]+$"}, "title": {"type":"string"}, "url": {"type":"string", "pattern":"^https://"}, "type": {"enum":["primary", "attributed-firsthand", "secondary", "method"]}, "year": {"type":"integer", "minimum":1900}, "note": {"type":"string"}}}},
    "frameworks": {"type":"object", "additionalProperties":false, "required":["porter","socratic","james","dmaic"], "properties": {
      "porter": {"$ref":"#/$defs/framework"},
      "socratic": {"$ref":"#/$defs/framework"},
      "james": {"$ref":"#/$defs/framework"},
      "dmaic": {"$ref":"#/$defs/framework"}
    }}
  },
  "$defs": {"framework": {"type":"object", "required":["title","subtitle","decision","steps"], "additionalProperties":false, "properties": {"title":{"type":"string"}, "subtitle":{"type":"string"}, "decision":{"type":"string"}, "steps":{"type":"array", "items":{"type":"object", "required":["name","question","finding","evidence","caution","action"], "additionalProperties":false, "properties":{"name":{"type":"string"},"question":{"type":"string"},"finding":{"type":"string"},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}},"caution":{"type":"string"},"action":{"type":"string"}}}}}}}
}
